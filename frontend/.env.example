# Copy to .env.local (git-ignored) and adjust.

# Read static JSON from public/mock-data/ instead of calling the backend.
# Use this for frontend-only work when the FastAPI backend isn't running.
VITE_USE_MOCK=true

# Backend origin for API calls. Leave empty to call same-origin /api, which the
# Vite dev server proxies to VITE_API_PROXY_TARGET.
VITE_API_BASE_URL=

# Where the dev server forwards /api requests (default http://localhost:8000).
VITE_API_PROXY_TARGET=http://localhost:8000
